{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Sekundär",
	"slug": "secondary",
	"blockTypes": [ "core/button" ],
	"styles": {
		"elements": {
			"button": {
				"color": { "background": "var:preset|color|accent-2", "text": "var:preset|color|contrast" },
				"border": { "color": "var:preset|color|accent-6" },
				"typography": { "fontWeight": "600" },
				":hover": {
					"color": { "background": "var:preset|color|accent-6", "text": "var:preset|color|white" },
					"border": { "color": "var:preset|color|accent-6" }
				}
			}
		}
	}
}
